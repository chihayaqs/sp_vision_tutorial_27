<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- 先完成导航循环，再关闭控制输出，最后返回成功。 -->
    <Sequence>
      <nav_RepeatSequence>
        <nav_RateControl hz="20">
          <nav_GetPose parent_frame="map"
                   child_frame="base_link"
                   timeout_ms="50"
                   pose="{start_pose}"/>
        </nav_RateControl>
        <!-- 每秒重规划一次，更新剩余路径，同时减少参考路径的频繁变化。 -->
        <nav_RateControl hz="1">
          <Fallback>
            <Sequence>
              <nav_ComputePathService service_name="make_plan"
                                  start="{start_pose}"
                                  goal="{goal_pose}"
                                  path="{global_plan}"/>
              <nav_SetControlEnable enable="true"
                                service_name="/set_control_enable"
                                bb_key="controller_enabled"/>
            </Sequence>
            <Sequence>
              <nav_SetControlEnable enable="false"
                                service_name="/set_control_enable"
                                bb_key="controller_enabled"/>
              <RetryUntilSuccessful num_attempts="100">
                <Delay delay_msec="100">
                  <nav_ComputePathService service_name="make_plan"
                                      start="{start_pose}"
                                      goal="{goal_pose}"
                                      path="{global_plan}"/>
                </Delay>
              </RetryUntilSuccessful>
              <nav_SetControlEnable enable="true"
                                service_name="/set_control_enable"
                                bb_key="controller_enabled"/>
            </Sequence>
          </Fallback>
        </nav_RateControl>
        <!-- 距离小于 0.04 米且合速度小于 0.06 m/s，才结束导航循环。 -->
        <nav_NavStateTrack goal_pose="{goal_pose}"
                       goal_tolerance="0.04"
                       goal_speed_tolerance="0.06"
                       odom_topic="/Odometry"
                       remaining_distance="{remaining_distance}"
                       elapsed_time="{elapsed_time}"/>
      </nav_RepeatSequence>
      <!-- 到达后关闭控制输出，完成停车。 -->
      <nav_SetControlEnable enable="false"
                            service_name="/set_control_enable"
                            bb_key="controller_enabled"/>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Control ID="nav_RepeatSequence"/>
    <Decorator ID="nav_RateControl">
      <input_port name="hz" default="10.0" type="double">子节点 tick 频率 Hz</input_port>
    </Decorator>
    <Action ID="nav_GetPose">
      <input_port name="parent_frame" default="map" type="std::string">父坐标系（参考系）</input_port>
      <input_port name="child_frame" default="base_link" type="std::string">子坐标系（机器人）</input_port>
      <input_port name="timeout_ms" default="100.0" type="double">等待 TF 的超时时间 ms</input_port>
      <output_port name="pose" type="geometry_msgs::msg::PoseStamped">child 在 parent 下的位姿</output_port>
    </Action>
    <Action ID="nav_ComputePathService">
      <input_port name="service_name" default="make_plan" type="std::string">全局规划 ROS 服务名</input_port>
      <input_port name="start" type="geometry_msgs::msg::PoseStamped">起点位姿</input_port>
      <input_port name="goal" type="geometry_msgs::msg::PoseStamped">终点位姿</input_port>
      <output_port name="path" type="nav_msgs::msg::Path">规划得到的全局路径</output_port>
    </Action>
    <Action ID="nav_SetControlEnable">
      <input_port name="enable" type="bool">true=启用控制器，false=停控并输出零速</input_port>
      <input_port name="service_name" default="/set_control_enable" type="std::string">SetBool 服务名</input_port>
      <input_port name="bb_key" default="controller_enabled" type="std::string">记录使能状态的 blackboard key；相同 key 可跳过重复调用</input_port>
    </Action>
    <Action ID="nav_NavStateTrack">
      <input_port name="goal_pose" type="geometry_msgs::msg::PoseStamped">导航目标位姿</input_port>
      <input_port name="goal_tolerance" default="0.2" type="double">到达判据：与目标欧氏距离阈值 m</input_port>
      <!-- 登记速度阈值与里程计话题，和 C++ 节点输入端口保持一致。 -->
      <input_port name="goal_speed_tolerance" default="0.06" type="double">到达判据：线速度阈值 m/s</input_port>
      <input_port name="odom_topic" default="/Odometry" type="std::string">机器人里程计话题</input_port>
      <output_port name="remaining_distance" type="double">距目标剩余距离 m</output_port>
      <output_port name="elapsed_time" type="double">本段任务已用时间 s</output_port>
    </Action>
  </TreeNodesModel>
</root>
